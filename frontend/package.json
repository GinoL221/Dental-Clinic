{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite preview",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:process": "node --test --test-timeout=20000 tests/fullstack/process-runner.spec.js",
    "test:e2e:fullstack": "node tests/fullstack/run-fullstack.js",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "check": "svelte-check --tsconfig ./jsconfig.json",
    "format": "prettier --write \"**/*.{js,json,css,md,svelte}\"",
    "format:check": "prettier --check \"**/*.{js,json,css,md,svelte}\""
  },
  "devDependencies": {
    "@babel/preset-env": "7.29.7",
    "@playwright/test": "^1.42.1",
    "@sveltejs/adapter-auto": "7.0.1",
    "@sveltejs/kit": "2.70.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/node": "24.13.3",
    "jsdom": "29.1.1",
    "prettier": "^3.3.2",
    "svelte": "5.56.6",
    "svelte-check": "4.7.3",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "dotenv": "^17.2.1"
  }
}
