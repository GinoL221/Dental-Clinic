{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "start": "node build",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:process": "node --test --test-timeout=20000 tests/fullstack/process-runner.spec.js tests/fullstack/*.test.js",
    "test:e2e:fullstack": "node tests/fullstack/run-fullstack.js",
    "test:e2e:fullstack:firefox": "E2E_ENABLE_FIREFOX=1 node tests/fullstack/run-fullstack.js",
    "test:e2e:fullstack:webkit": "E2E_ENABLE_WEBKIT=1 node tests/fullstack/run-fullstack.js",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "check": "svelte-check --tsconfig ./jsconfig.json",
    "format": "prettier --write \"**/*.{js,json,css,md,svelte}\"",
    "format:check": "prettier --check \"**/*.{js,json,css,md,svelte}\"",
    "lint": "eslint --max-warnings 0 ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.42.1",
    "@sveltejs/adapter-node": "6.0.5",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "prettier": "^3.3.2",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.58.0",
    "svelte-check": "4.7.3",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "bootstrap": "5.3.3",
    "bootstrap-icons": "1.11.3"
  }
}
