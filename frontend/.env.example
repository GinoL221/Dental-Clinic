# Frontend — Variables de entorno de ejecución (SvelteKit adapter-node)
# Copiar este archivo como .env en desarrollo local si querés sobrescribir defaults
# NUNCA commitear el archivo .env

# URL base del backend Spring Boot (server-side; sin trailing slash)
BACKEND_URL=http://localhost:8080

# Origen público del frontend en producción (ej. https://dental-clinic.up.railway.app)
# Requerido detrás de proxy inverso si no se reenvían x-forwarded-proto / x-forwarded-host
# ORIGIN=https://tu-frontend.up.railway.app

# Host y puerto de escucha del servidor Node (`node build`)
HOST=0.0.0.0
PORT=3000

# Headers de proxy inverso (útiles en Railway / PaaS detrás de TLS)
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
