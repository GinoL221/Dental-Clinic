# Backend — Variables de entorno
# Copiar como backend/.env para desarrollo local (nunca commitear .env)

# Clave secreta HMAC-SHA256 en Base64 válido de al menos 32 bytes (256 bits)
# Generar con: openssl rand -base64 32
JWT_SECRET=replace-with-base64-secret-min-32-bytes

# Perfil activo: dev (default, H2 en memoria) | prod (MySQL + Flyway)
# SPRING_PROFILES_ACTIVE=dev

# Requeridas cuando SPRING_PROFILES_ACTIVE=prod (Railway MySQL)
# DB_URL=jdbc:mysql://host:3306/railway?useSSL=true&serverTimezone=UTC
# DB_USER=root
# DB_PASS=replace-with-db-password

# Orígenes permitidos por CORS (separados por coma)
# CORS_ALLOWED_ORIGINS=https://tu-frontend.up.railway.app

# Modo demo público en prod (solo para portafolio; default false)
# APP_DEMO_ENABLED=false
